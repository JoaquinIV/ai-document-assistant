# Server
NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_assistant

# LLM Provider
# Options: "openai" | "ollama" | "mock"
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (free, local — no API key needed; run `ollama serve` and pull the
# models below first). See backend/src/modules/llm/providers/ollama.provider.ts
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Rate limiting / cost control
MAX_REQUESTS_PER_MINUTE_PER_USER=10
MAX_TOKENS_PER_REQUEST=2000
